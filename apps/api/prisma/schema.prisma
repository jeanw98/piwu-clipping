datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  PENDING
  GENERATING_SCRIPT
  AWAITING_APPROVAL
  GENERATING_AUDIO
  GENERATING_ASSETS
  RENDERING
  COMPLETED
  FAILED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String?
  role           Role            @default(USER)
  /// On-screen presenter for the "what-if" format (transparent PNG/WebP in storage).
  presenterUrl   String?
  presenterName  String?
  presenterAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  refreshTokens  RefreshToken[]
  clipJobs       ClipJob[]
  projects       Project[]
  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
  automations    Automation[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String
  memorySummary      String              @default("")
  defaultVisualStyle String?
  defaultMotion      String?
  /// ElevenLabs voice for the project's clips (null = env default).
  defaultVoiceId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  references         ProjectReference[]
  clipJobs           ClipJob[]
  assetCache         ProjectAssetCache[]

  @@index([userId, createdAt])
}

model ProjectReference {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String
  url       String
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, role])
}

model ProjectAssetCache {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptHash String
  assetType  String
  url        String
  byteLength Int?
  createdAt  DateTime @default(now())

  @@unique([projectId, promptHash, assetType])
  @@index([projectId])
}

model ClipJob {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  prompt          String
  stylePreset     String          @default("viral")
  durationSec     Int             @default(30)
  orientation     String          @default("portrait")
  resolution      String          @default("1080p")
  platform        String          @default("tiktok")
  language        String          @default("es-LA")
  sourceType      String          @default("prompt")
  sourceUrl       String?
  captionStyle    Json?
  clipCount       Int             @default(5)
  visualStyle     String          @default("ugc")
  motion          String          @default("auto")
  /// ElevenLabs voice chosen for this clip (null = project / env default).
  voiceId         String?
  /// Content format: "free" | "what-if".
  format          String          @default("free")
  /// Presenter image snapshot (what-if); null = no presenter on screen.
  presenterUrl    String?
  status          JobStatus       @default(PENDING)
  progress        Int             @default(0)
  title           String?
  audioScript     String?
  audioUrl        String?
  timestampsJson  Json?
  scriptJson      Json?
  referenceUrls   String[]        @default([])
  referenceMeta   Json?
  costJson        Json?
  outputVideoUrl  String?
  coverUrl        String?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assets          MediaAsset[]
  variants        ClipVariant[]
  scheduledPosts  ScheduledPost[]
  /// Set when the clip was created by a daily automation run.
  automationRunId String?
  automationRun   AutomationRun?  @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([automationRunId])
}

model ClipVariant {
  id             String    @id @default(uuid())
  clipJobId      String
  clipJob        ClipJob   @relation(fields: [clipJobId], references: [id], onDelete: Cascade)
  index          Int
  title          String
  score          Int       @default(0)
  reason         String    @default("")
  startSec       Float
  endSec         Float
  outputVideoUrl String?
  status         JobStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clipJobId, index])
  @@index([clipJobId, score])
}

model MediaAsset {
  id          String   @id @default(uuid())
  clipJobId   String
  clipJob     ClipJob  @relation(fields: [clipJobId], references: [id], onDelete: Cascade)
  sceneIndex  Int
  prompt      String
  type        String
  url         String
  durationSec Float
  createdAt   DateTime @default(now())

  @@index([clipJobId])
}

/// A linked YouTube / Instagram / TikTok account (OAuth). Tokens are AES-256-GCM encrypted.
model SocialAccount {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  externalId      String
  displayName     String
  avatarUrl       String?
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String[]        @default([])
  meta            Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  posts           ScheduledPost[]

  @@unique([userId, provider, externalId])
  @@index([userId])
}

/// A clip (or highlight variant) to publish on one account, now or at `scheduledAt`.
model ScheduledPost {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipJobId       String
  clipJob         ClipJob       @relation(fields: [clipJobId], references: [id], onDelete: Cascade)
  variantId       String?
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  provider        String
  title           String?
  caption         String        @default("")
  privacy         String        @default("public")
  scheduledAt     DateTime
  status          String        @default("SCHEDULED")
  attempts        Int           @default(0)
  externalPostId  String?
  externalUrl     String?
  errorMessage    String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([clipJobId])
}

/// Daily content automation: plans topics, creates clip jobs, zips the results.
model Automation {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  enabled           Boolean         @default(true)
  runHour           Int
  runMinute         Int             @default(0)
  timezone          String          @default("America/Guayaquil")
  topicHint         String          @default("")
  useTrends         Boolean         @default(true)
  projectId         String?
  /// AutomationBlock[] (see @piwu/shared automationBlockSchema)
  blocks            Json
  /// Local date (YYYY-MM-DD) of the last scheduled run, to fire once a day.
  lastScheduledDate String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  runs              AutomationRun[]

  @@index([userId])
}

model AutomationRun {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String
  /// 1, 2, 3… per automation (zip is videosdia<seq>.zip)
  seq          Int
  localDate    String
  /// schedule | manual
  trigger      String     @default("schedule")
  /// PLANNING | RUNNING | ZIPPING | COMPLETED | PARTIAL | FAILED
  status       String     @default("PLANNING")
  topics       String[]   @default([])
  /// AutomationRunItem[]
  items        Json       @default("[]")
  error        String?
  zipPath      String?
  zipName      String?
  videoCount   Int        @default(0)
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?
  clipJobs     ClipJob[]

  @@unique([automationId, seq])
  @@index([status])
}
