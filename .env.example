# Application
NODE_ENV=development
PORT=3000

# Database & Cache
# Docker Compose: postgresql://clipping:clipping@localhost:5432/clipping_db?schema=public
DATABASE_URL="postgresql://jeanmwd@localhost:5432/piwu-clipping?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET="super_secret_jwt_access_key_change_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_change_in_production"
JWT_REFRESH_EXPIRATION="7d"

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Single admin login (register is disabled)
ADMIN_EMAIL=admin@piwumarket.com
ADMIN_PASSWORD=change-me-admin

# External AI APIs
ANTHROPIC_API_KEY="sk-ant-api03-..."
ANTHROPIC_MODEL="claude-sonnet-4-5"
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
OPENAI_API_KEY="sk-proj-..."
LEONARDO_API_KEY="your_leonardo_key"
RUNWAY_API_SECRET=""
MINIMAX_API_KEY="your_minimax_key"
MINIMAX_VIDEO_MODEL="MiniMax-Hailuo-2.3-Fast"
MINIMAX_VIDEO_RESOLUTION="768P"
# Optional: better tier only for the hook scene (empty = same as above)
MINIMAX_HOOK_MODEL=""
MINIMAX_HOOK_RESOLUTION=""
MINIMAX_VIDEO_TIMEOUT_MS=600000

# Storage (local | s3)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=piwallet
S3_PREFIX=piwu-clipping
S3_PUBLIC_BASE_URL=https://piwallet.s3.us-east-1.amazonaws.com

# Frontend (apps/web/.env)
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=http://localhost:3001
